<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:chart="UnityChart.Editor" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <chart:LineChart data-providers="hp, stamina, mana, xp" name="LineChart" style="width: 100%; height: 250px;" />
    <ui:Label text="This sample shows the real-time value of 4 variables in an editor window. The values are generated by the game object called &quot;DataProviderForEditorWindow&quot; in the sample scene inside editor window line chart sample.&#10;Each time you press play, the chart resets. &#10;Resize the editor window and the chart adapts to it. The legend adapts too. &#10;If you exit play mode and re-enter it, the chart clears up.&#10;You can inspect and browse data collected in the play mode after exiting it or during play mode. Hover your mouse over the graph and you should see it.&#10;See the source code of the sample to see how it works." enable-rich-text="false" style="height: 194px; white-space: normal;" />
</ui:UXML>
